# Copier ce fichier en .env et renseigner les valeurs.

# Clé secrète Django (obligatoire en production)
DJANGO_SECRET_KEY=changez-moi-par-une-cle-aleatoire-longue
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données ---
# DB_ENGINE=postgresql (défaut) ou sqlite
DB_ENGINE=postgresql
POSTGRES_DB=gestion_univ
POSTGRES_USER=eni
POSTGRES_PASSWORD=eni2024
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Intelligence artificielle (OpenAI). Laisser vide => moteur local de repli. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Identité de l'établissement
UNIVERSITY_NAME=Université ENI
UNIVERSITY_SHORT=ENI
